# Set DOMAIN at runtime: `DOMAIN=quake.example.com docker compose up -d`
# Local testing default falls back to :80 (no TLS).
{$DOMAIN:localhost} {
	# HTML pages must always revalidate, or browsers keep stale copies
	# after server-side updates (scripts out of sync with fetched assets).
	@pages path / /index.html /admin.html
	header @pages Cache-Control "no-cache"

	# the engine bundle changes whenever the wasm is rebuilt; revalidate
	@engine path /ioquake3.js /ioquake3.wasm
	header @engine Cache-Control "no-cache"

	@ws path /ws
	handle @ws {
		reverse_proxy gateway:8080
	}

	@admin_api path /admin/api/*
	handle @admin_api {
		reverse_proxy gateway:8080
	}

	# launcher download list (/paks) and map gallery (/maps, /levelshot/<map>)
	@gallery path /paks /maps /levelshot/*
	handle @gallery {
		reverse_proxy gateway:8080
	}

	# launcher server picker: relay of the Q3JS master's community list
	@master_servers path /servers
	handle @master_servers {
		reverse_proxy gateway:8080
	}

	handle_path /assets/* {
		root * /srv/data
		file_server
	}

	handle {
		root * /srv/web
		file_server
	}
}
