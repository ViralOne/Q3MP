# Set DOMAIN at runtime: `DOMAIN=quake.example.com docker compose up -d`
# Local testing default falls back to :80 (no TLS).
{$DOMAIN:localhost} {
	# HTML pages must always revalidate, or browsers keep stale copies
	# after server-side updates (scripts out of sync with fetched assets).
	@pages path / /index.html /admin.html
	header @pages Cache-Control "no-cache"

	# the engine bundle changes whenever the wasm is rebuilt; revalidate
	@engine path /ioquake3.js /ioquake3.wasm
	header @engine Cache-Control "no-cache"

	@ws path /ws
	handle @ws {
		reverse_proxy gateway:8080
	}

	@admin_api path /admin/api/*
	handle @admin_api {
		reverse_proxy gateway:8080
	}

	# launcher download list (/paks) and map gallery (/maps, /levelshot/<map>)
	@gallery path /paks /maps /modes /levelshot/* /stats
	handle @gallery {
		reverse_proxy gateway:8080
	}

	# launcher server picker: relay of the Q3JS master's community list
	@master_servers path /servers
	handle @master_servers {
		reverse_proxy gateway:8080
	}

	# PK3 downloads. Edge caching (Cloudflare + a Cache Rule for /assets/) is
	# opt-in through PAK_CACHE_CONTROL, e.g. "public, max-age=0, s-maxage=86400":
	# a cached pak is served to anyone, so only enable it when the site is
	# public or gated at the edge (Cloudflare Access) — never behind a
	# password checked here or in a proxy after Cloudflare. Browsers always
	# revalidate (the launcher keeps its own OPFS copy and checks the ETag).
	# zz-*.pk3 are small and change in place, so they are never edge-cached.
	@zzpak path_regexp ^/assets/[^/]+/zz-[^/]*\.pk3$
	header @zzpak Cache-Control "no-cache"
	@pak {
		path /assets/*
		not path_regexp ^/assets/[^/]+/zz-[^/]*\.pk3$
	}
	header @pak Cache-Control "{$PAK_CACHE_CONTROL:no-cache}"

	handle_path /assets/* {
		root * /srv/data
		file_server
	}

	handle {
		root * /srv/web
		file_server
	}
}
