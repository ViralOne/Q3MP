Q3JS_LIVEKIT_URL=https://staging.livekit.q3js.com
Q3JS_LIVEKIT_API_KEY=replace-with-the-livekit-api-key
Q3JS_LIVEKIT_API_SECRET=replace-with-the-livekit-api-secret
Q3JS_LIVEKIT_TOKEN_TTL=6h
Q3JS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
Q3JS_ADMIN_TOKEN_TTL=1h
Q3JS_ADMIN_JWT_PRIVATE_KEY_LOCATION=/state/q3js-admin-private-key.pem
Q3JS_ADMIN_JWT_PUBLIC_KEY_LOCATION=/state/q3js-admin-public-key.pem

# Export stays disabled locally unless explicitly enabled.
Q3JS_TELEMETRY_DISABLED=true
Q3JS_ENVIRONMENT=local
Q3JS_OTLP_ENDPOINT=http://localhost:4317
